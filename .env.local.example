# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Public site URL (auth redirects, Open Graph)
NEXT_PUBLIC_SITE_URL=https://rv-chain.com

# Comma-separated admin emails (featured listings, Seller Pro grants)
# Empty = any signed-in user can moderate (MVP only — set this in production)
NEXT_PUBLIC_MODERATOR_EMAILS=you@example.com

# Optional sandbox banner (default off)
# NEXT_PUBLIC_SITE_DEMO_MODE=true

# Google Analytics 4 (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact form → emails this address (default admin@rv-chain.com)
# CONTACT_TO_EMAIL=admin@rv-chain.com

# Recommended for reliable delivery (https://resend.com — free tier):
# RESEND_API_KEY=re_xxxx
# CONTACT_FROM_EMAIL=rvchain <onboarding@resend.dev>
# Without Resend: browser FormSubmit + Supabase contact_messages table.

# Trailhead AI (xAI / Grok) — server-side only
# Get a key: https://console.x.ai
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4-1-fast-non-reasoning


# After tables exist: run supabase-marketplace.sql in Supabase SQL Editor
# Create public storage bucket "listing-images" if the SQL insert is blocked

